[Unit]
Description=LiteLLM proxy (Anthropic -> Ornith on laptop)
After=network.target

[Service]
User=<USER>
WorkingDirectory=/vol1/1000/bots
ExecStart=/vol1/1000/bots/litellm-venv/bin/litellm --model openai/ornith-1.0-35b-Q4_K_M.gguf --api_base http://<LAPTOP_IP>:8080/v1 --port 4025 --host 0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
